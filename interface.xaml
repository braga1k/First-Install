<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Title="First Install 2.6" Width="1240" Height="840" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#101216" Foreground="#F3F5F7" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="MinHeight" Value="36"/><Setter Property="Foreground" Value="#DCE1E7"/><Setter Property="Background" Value="#23272F"/><Setter Property="BorderBrush" Value="#343A44"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CardCheck" TargetType="CheckBox">
   <Setter Property="Foreground" Value="#F3F5F7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Card" Background="#1B1E25" BorderBrush="#2B3039" BorderThickness="1" CornerRadius="10" Padding="15">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><ContentPresenter/><Border x:Name="Box" Grid.Column="1" Width="18" Height="18" CornerRadius="5" BorderBrush="#657080" BorderThickness="1" VerticalAlignment="Top"><TextBlock x:Name="Mark" Text="✓" Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="Bold" HorizontalAlignment="Center" Visibility="Collapsed"/></Border></Grid>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSurfaceBrush}"/><Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#9BA9B8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#1B1E25"/><Setter Property="Foreground" Value="#F3F5F7"/><Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="#343A44"/><Setter Property="Padding" Value="12,9"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentMutedBrush}"/></Style>
  <!-- A slim visible handle with a wider, transparent pointer target. -->
  <Style x:Key="ScrollPage" TargetType="RepeatButton">
   <Setter Property="Focusable" Value="False"/>
   <Setter Property="IsTabStop" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ScrollHandle" TargetType="Thumb">
   <Setter Property="MinHeight" Value="28"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Thumb">
     <Border Background="Transparent"><Border x:Name="Handle" Margin="3,2" CornerRadius="3" Background="{DynamicResource AccentMutedBrush}"/></Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource AccentHoverBrush}"/></Trigger>
      <Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger>
      <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal"><Setter TargetName="Handle" Property="Margin" Value="2,3"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="28"/></DataTrigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="12"/><Setter Property="MinWidth" Value="0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ScrollBar">
     <Grid Background="{TemplateBinding Background}">
      <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
       <Track.Resources>
        <!-- WPF Track uses half these resource values as the minimum thumb length. -->
        <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">96</sys:Double>
        <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">96</sys:Double>
       </Track.Resources>
       <Track.DecreaseRepeatButton><RepeatButton x:Name="PageBefore" Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
       <Track.Thumb><Thumb Style="{StaticResource ScrollHandle}"/></Track.Thumb>
       <Track.IncreaseRepeatButton><RepeatButton x:Name="PageAfter" Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
      </Track>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="PageBefore" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="PageAfter" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="CaptionButton" TargetType="Button">
   <Setter Property="Width" Value="46"/><Setter Property="Height" Value="38"/>
   <Setter Property="Foreground" Value="#A0AAB7"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="ToolTipService.ShowDuration" Value="3000"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentMutedBrush}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ContextMenu">
   <Setter Property="Background" Value="#171A20"/><Setter Property="Foreground" Value="#F3F5F7"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="#343A44" BorderThickness="1" CornerRadius="10" Padding="6"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="Padding" Value="12,9"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="MenuSurface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource AccentSurfaceBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuSurface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>

 <Grid x:Name="WindowSurface" Background="#101216">
 <Grid x:Name="AppPanes">
  <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
  <Border Background="#15181D" BorderBrush="#292D35" BorderThickness="0,0,1,0">
   <DockPanel Margin="20,28,15,22" LastChildFill="True">
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="FIRST /" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/><TextBlock Text="INSTALL" FontSize="25" FontWeight="Bold" Margin="0,-5,0,0"/><TextBlock Text="Your PC. Your way." Foreground="#929DAA" FontSize="12" Margin="0,12,0,32"/><TextBlock Text="LIBRARY" Foreground="#A0AAB7" FontSize="12" FontWeight="Bold" Margin="8,0,0,12"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="#303640" Margin="0,12"/><TextBlock Text="APP INSTALLER" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" FontWeight="Bold"/><TextBlock Text="Windows · x64&#10;First Install 2.6" Foreground="#8793A2" FontSize="12" Margin="0,8,0,0"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Categories"/></ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="22,34,18,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="APPLICATIONS" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"/><TextBlock Text="Make it your PC." TextWrapping="Wrap" FontSize="27" FontWeight="SemiBold" Margin="0,9,0,8"/><TextBlock Text="Choose your apps. Build a setup that feels like yours." Foreground="#A0AAB7" TextWrapping="Wrap"/><TextBlock x:Name="Environment" Text="Checking WinGet…" Foreground="#8E9AA8" FontSize="12" Margin="0,14,0,0"/></StackPanel>
   <Grid Grid.Row="1" Margin="0,22,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Search apps · Ctrl+F" Foreground="#A0AAB7" Margin="0,0,0,6"/><TextBox x:Name="Search" ToolTip="Search by name, description or category" AutomationProperties.Name="Search apps"/></StackPanel><Button x:Name="ClearSearch" Grid.Column="1" Content="Clear search" VerticalAlignment="Bottom" Margin="8,0,0,0"/></Grid>
   <StackPanel Grid.Row="2" Margin="0,0,0,16"><TextBlock x:Name="ResultCount" VerticalAlignment="Center" Foreground="#A0AAB7"/><WrapPanel Margin="0,8,0,0"><Button x:Name="Profiles" Content="All profiles ▾" Padding="12,6" ToolTip="Choose a setup profile. Replaces your current selection without installing."/><Button x:Name="UserProfiles" Content="User profiles ▾" Padding="12,6" ToolTip="Save your selection as a profile or load a saved profile"/><Button x:Name="ClearSelection" Content="Clear selection" Padding="12,6" Margin="0"/></WrapPanel><TextBlock Text="Profiles replace your selection. Review before installing." Foreground="#A0AAB7" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
   <ScrollViewer x:Name="LibraryScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><WrapPanel x:Name="Cards" Width="{Binding ViewportWidth, ElementName=LibraryScroll}" HorizontalAlignment="Left"/><TextBlock x:Name="Empty" Text="No apps found. Try another search or filter." Visibility="Collapsed" Foreground="#A0AAB7" Margin="0,25" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
   <Expander Grid.Row="4" Header="Activity &amp; details" Foreground="#A0AAB7" Margin="0,14,0,0"><TextBox x:Name="LogBox" IsReadOnly="True" Height="135" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Expander>
  </Grid>
  <Border Grid.Column="2" Background="#171A20" BorderBrush="#292D35" BorderThickness="1,0,0,0">
   <Grid Margin="18,58,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Your setup" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="SelectedCount" Text="0 apps selected" Foreground="#929DAA" Margin="0,8,0,18"/><Border Height="1" Background="#303640" Margin="0,20,0,12"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="QueuePanel"/></ScrollViewer>
    <StackPanel Grid.Row="2"><Border Height="1" Background="#303640" Margin="0,14"/><TextBlock x:Name="Status" Text="Ready when you are." TextWrapping="Wrap" Foreground="#B6C0CC" Margin="0,0,0,10"/><TextBlock Text="Queue progress · apps processed" Foreground="#A0AAB7" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/><ProgressBar x:Name="Progress" AutomationProperties.Name="App queue progress" Height="5" Background="#303640" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0" Minimum="0" Maximum="100" Margin="0,0,0,14"/><TextBlock Text="Automatic: installs with WinGet.&#10;Guided: opens the official download page." Foreground="#8793A2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/><Button x:Name="Install" Content="Review &amp; install  →" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" BorderBrush="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0"/><Button x:Name="Cancel" Content="Stop after current app" Margin="0,8,0,0" Visibility="Collapsed"/><Button x:Name="OpenLogs" Content="Open logs" Background="Transparent" BorderThickness="0" Padding="8" Margin="0,6,0,0"/></StackPanel>
   </Grid>
  </Border>
 </Grid>

   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10" Margin="0,0,4,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button x:Name="MinimizeWindow" Style="{StaticResource CaptionButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/></Button>
    <Button x:Name="MaximizeWindow" Style="{StaticResource CaptionButton}" ToolTip="Maximize" AutomationProperties.Name="Maximize"><Path x:Name="MaximizeGlyph" Data="M 0,0 L 10,0 10,10 0,10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/></Button>
    <Button x:Name="CloseWindow" Style="{StaticResource CaptionButton}" ToolTip="Close" AutomationProperties.Name="Close"><Path Data="M 0,0 L 10,10 M 0,10 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/></Button>
   </StackPanel>
 </Grid>
</Window>
